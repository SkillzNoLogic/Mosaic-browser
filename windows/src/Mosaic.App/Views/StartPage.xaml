<UserControl x:Class="Mosaic.App.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource LayerFillColorDefaultBrush}">
    <!-- What a blank tab shows. DataContext: BrowserModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <Image Source="/Assets/Mosaic.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Mosaic"
                       Margin="0,14,0,22"
                       HorizontalAlignment="Center"
                       FontSize="34"
                       FontWeight="SemiBold" />

            <Border Style="{StaticResource FieldBorderStyle}"
                    Width="520" MaxWidth="520" Height="42"
                    CornerRadius="12"
                    Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE721;" FontSize="14" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" FontSize="15" Text="{Binding AddressPlaceholder}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=QueryBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             Style="{StaticResource BareTextBoxStyle}"
                             FontSize="15"
                             KeyDown="QueryBox_KeyDown"
                             AutomationProperties.Name="Search or enter address" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource EngineGeckoBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChromiumEngine}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource EngineChromiumBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding StartPageCaption}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
