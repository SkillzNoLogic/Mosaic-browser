<UserControl x:Class="Mosaic.App.Views.BlockerPopover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320">
    <!-- The content blocker's controls, shown from the shield in the toolbar. Same controls and
         wording as Sources/Mosaic/Views/BlockerPopover.swift. DataContext: BrowserModel. -->
    <Border Padding="14"
            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <StackPanel>
            <TextBlock Text="Content Blocker" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,2,0,0"
                       FontSize="12"
                       Text="Built in. Uses uBlock Origin’s filtering engine and filter lists." />

            <!-- Not part of this build. -->
            <Grid Margin="0,12,0,0"
                  Visibility="{Binding Blocker.IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}"
                           Foreground="{StaticResource CautionBrush}"
                           Margin="0,2,8,0"
                           Text="&#xE7BA;" />
                <TextBlock Grid.Column="1"
                           Foreground="{StaticResource CautionBrush}"
                           TextWrapping="Wrap"
                           Text="Not included in this build. Run scripts\bootstrap.ps1 and rebuild." />
            </Grid>

            <StackPanel Visibility="{Binding Blocker.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <CheckBox Margin="0,12,0,0"
                          Content="Block ads and trackers"
                          IsChecked="{Binding Blocker.IsEnabled, Mode=OneWay}"
                          Click="Enabled_Click" />

                <!-- Only for a web page: the site in front. -->
                <StackPanel Visibility="{Binding HasBlockerSite, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Margin="0,8,0,0"
                              Content="{Binding BlockerSiteLabel}"
                              IsChecked="{Binding IsBlockingSite, Mode=OneWay}"
                              IsEnabled="{Binding Blocker.IsEnabled}"
                              Click="Site_Click" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding BlockedCountText}"
                               Visibility="{Binding IsFilteringPage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Border Height="1" Margin="0,12" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="{Binding Blocker.StatusLine}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" FontSize="12" Text="{Binding Blocker.ListsLine}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Update Lists"
                            Click="UpdateLists_Click"
                            Visibility="{Binding Blocker.IsUpdating, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Control Grid.Column="1"
                             Style="{StaticResource SpinnerStyle}"
                             Margin="12,0,0,0"
                             Visibility="{Binding Blocker.IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,12,0,0"
                           FontSize="12"
                           Text="Blocks network requests. It does not yet hide leftover page elements or run uBlock Origin’s scriptlets, so some ads (video ads in particular) can still appear." />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
