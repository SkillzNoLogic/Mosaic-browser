<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-independent logic. No UI and no Windows-only APIs, so it builds
       and its tests run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mosaic.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mosaic.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- V8, to run uBlock Origin's filtering engine for Chromium (WebView2) tabs. The native
         packages cover the platforms Mosaic ships on plus Apple Silicon, where the tests run. -->
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.5.1.1" />
    <!-- library: SQLite for bookmarks, history, reading list and search engines (Library.sqlite,
         same schema as macOS). Its SQLitePCLRaw.bundle_e_sqlite3 dependency ships the native
         e_sqlite3 for win-x64 and win-arm64 (and osx-arm64/linux, where the tests run). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>
</Project>
