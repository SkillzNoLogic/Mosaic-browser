<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Mosaic.App</RootNamespace>
    <AssemblyName>Mosaic</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Mosaic.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mosaic.Core\Mosaic.Core.csproj" />
  </ItemGroup>
  <!-- The content blocker, as scripts\bootstrap.ps1 builds it: uBlock Origin's engine, its
       licence and the filter-list snapshot, loaded from blocker\ next to the executable.
       Without it the app builds without the blocker, which then reports itself unavailable. -->
  <ItemGroup Condition="Exists('..\..\vendor\ublock\ublock-engine.js')">
    <Content Include="..\..\vendor\ublock\ublock-engine.js;..\..\vendor\ublock\LICENSE-uBlock-Origin.txt" Link="blocker\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vendor\ublock\lists\*" Link="blocker\lists\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Mosaic's agent inside Gecko (shared with macOS: the repository's Resources/gecko), loaded from next to the executable. -->
    <Content Include="..\..\..\Resources\gecko\**\*" Link="gecko\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>
</Project>
