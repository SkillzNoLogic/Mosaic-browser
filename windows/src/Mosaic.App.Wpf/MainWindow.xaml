<Window x:Class="Mosaic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:Mosaic.Core.Browser;assembly=Mosaic.Core"
        xmlns:search="clr-namespace:Mosaic.Core.Search;assembly=Mosaic.Core"
        xmlns:hosting="clr-namespace:Mosaic.App.Hosting"
        xmlns:views="clr-namespace:Mosaic.App.Views"
        Title="Mosaic"
        Width="1240" Height="800"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- The whole window: tab strip, toolbar, content area. DataContext: BrowserModel.

         State is shown through bindings; actions are Click handlers in the code-behind, which the
         compiler checks. Web content (the Gecko host, WebView2) is made of native child windows
         that always draw above WPF content in the same place, so nothing here is ever layered
         over a page: Mosaic's own views take the content area only while the page is hidden, and
         the things that float above a page, the notice and the content blocker's popover, are
         Popups (windows of their own). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Tab strip ===== -->
        <ScrollViewer x:Name="TabScroller"
                      Grid.Row="0"
                      Margin="8,0"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="TabScroller_PreviewMouseWheel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl x:Name="TabList" ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type browser:BrowserTab}">
                            <Button Style="{StaticResource TabChipStyle}"
                                    Click="Tab_Click"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The engine dot gives way to a progress ring while the page loads. -->
                                    <Ellipse Style="{StaticResource EngineDotStyle}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             ToolTip="{Binding EngineHint}"
                                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Control Style="{StaticResource SpinnerStyle}"
                                             Width="11" Height="11"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="7,0,4,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{Binding DisplayTitle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            Content="&#xE8BB;"
                                            Click="CloseTab_Click"
                                            ToolTip="Close Tab (Ctrl+W)"
                                            AutomationProperties.Name="Close Tab" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="28" Height="28"
                        FontSize="12"
                        Content="&#xE710;"
                        Click="NewTab_Click"
                        ToolTip="New Tab (Ctrl+T)"
                        AutomationProperties.Name="New Tab" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Toolbar ===== -->
        <Grid Grid.Row="1" Margin="8,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE72B;"
                        IsEnabled="{Binding CanGoBack}"
                        Click="Back_Click"
                        ToolTip="Back (Alt+Left)"
                        AutomationProperties.Name="Back" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE72A;"
                        IsEnabled="{Binding CanGoForward}"
                        Click="Forward_Click"
                        ToolTip="Forward (Alt+Right)"
                        AutomationProperties.Name="Forward" />
                <!-- One button: Stop while the page loads, Reload otherwise. -->
                <Button IsEnabled="{Binding CanReload}" Click="ReloadOrStop_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Content" Value="&#xE72C;" />
                            <Setter Property="ToolTip" Value="Reload (Ctrl+R)" />
                            <Setter Property="AutomationProperties.Name" Value="Reload" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="&#xE711;" />
                                    <Setter Property="ToolTip" Value="Stop" />
                                    <Setter Property="AutomationProperties.Name" Value="Stop" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Address field -->
            <Border Grid.Column="1" Height="30" Margin="6,0,8,0" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource FieldBorderStyle}">
                        <Style.Triggers>
                            <!-- One pixel moves from the padding to the border, so the text stays put. -->
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddressBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Padding" Value="9,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
                                <Setter Property="Text" Value="&#xE721;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddressKind}" Value="{x:Static browser:AddressKind.Secure}">
                                        <Setter Property="Text" Value="&#xE72E;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AddressKind}" Value="{x:Static browser:AddressKind.Web}">
                                        <Setter Property="Text" Value="&#xE774;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" FontSize="13" Text="{Binding AddressPlaceholder}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=AddressBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="AddressBox"
                             Grid.Column="1"
                             Style="{StaticResource BareTextBoxStyle}"
                             FontSize="13"
                             Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="AddressBox_KeyDown"
                             PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                             GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                             LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                             AutomationProperties.Name="Address and search" />
                </Grid>
            </Border>

            <!-- Appears while a Chrome Web Store listing is open. -->
            <Button Grid.Column="2"
                    Style="{DynamicResource AccentButtonStyle}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Content="{Binding AddExtensionLabel}"
                    IsEnabled="{Binding Extensions.IsIdle}"
                    Visibility="{Binding ShowsAddExtension, Converter={StaticResource BoolToVisibility}}"
                    Click="AddExtension_Click"
                    ToolTip="Convert this Chrome extension and run it on the Mozilla engine" />

            <ComboBox Grid.Column="3"
                      MinWidth="132"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Static search:SearchEngine.BuiltIn}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SearchEngine, Mode=TwoWay}"
                      ToolTip="Search engine (Ctrl+Shift+S cycles)"
                      AutomationProperties.Name="Search engine" />

            <!-- Mozilla / Chromium switch for the current tab. -->
            <Border Grid.Column="4"
                    Margin="0,0,6,0"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6"
                    ToolTip="Rendering engine for this tab (Ctrl+Shift+E switches)">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SegmentButtonStyle}"
                            Tag="{Binding IsGeckoEngine}"
                            Click="UseGecko_Click"
                            AutomationProperties.Name="Mozilla engine">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{StaticResource EngineGeckoBrush}" />
                            <TextBlock Text="Mozilla" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SegmentButtonStyle}"
                            Tag="{Binding IsChromiumEngine}"
                            Click="UseChromium_Click"
                            AutomationProperties.Name="Chromium engine">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{StaticResource EngineChromiumBrush}" />
                            <TextBlock Text="Chromium" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content blocker: a shield showing whether the page in front is being filtered and
                 how much was blocked on it. While the popover is open the button lets clicks
                 through, so a click on it closes the popover (StaysOpen) instead of reopening it. -->
            <Button x:Name="BlockerButton"
                    Grid.Column="5"
                    Width="Auto"
                    MinWidth="32"
                    FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                    Style="{StaticResource IconButtonStyle}"
                    IsHitTestVisible="{Binding IsOpen, ElementName=BlockerPopup, Converter={StaticResource InverseBool}}"
                    Click="Blocker_Click"
                    ToolTip="{Binding BlockerHelp}"
                    AutomationProperties.Name="Content blocker"
                    AutomationProperties.HelpText="{Binding BlockerHelp}">
                <StackPanel Margin="8,0" Orientation="Horizontal">
                    <Grid Width="16" Height="16">
                        <TextBlock x:Name="ShieldGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Text="&#xEA18;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlockerShield}" Value="{x:Static browser:BlockerShield.Filtering}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BlockerShield}" Value="{x:Static browser:BlockerShield.Off}">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Neither icon font has a crossed-out shield, so the stroke is drawn. -->
                        <Line X1="2" Y1="14" X2="14" Y2="2"
                              Stroke="{Binding Foreground, ElementName=ShieldGlyph}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Line.Style>
                                <Style TargetType="Line">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlockerShield}" Value="{x:Static browser:BlockerShield.Off}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Line.Style>
                        </Line>
                    </Grid>
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Medium"
                               Typography.NumeralAlignment="Tabular"
                               Text="{Binding BlockerBadge}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BlockerBadge}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Popup x:Name="BlockerPopup"
                   Grid.Column="5"
                   PlacementTarget="{Binding ElementName=BlockerButton}"
                   Placement="Bottom"
                   HorizontalOffset="-140"
                   VerticalOffset="4"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   Closed="BlockerPopup_Closed">
                <views:BlockerPopover />
            </Popup>

            <Button Grid.Column="6"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xEA86;"
                    Click="Extensions_Click"
                    ToolTip="Extensions (Ctrl+Shift+X)"
                    AutomationProperties.Name="Extensions" />
        </Grid>

        <!-- ===== Content area ===== -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid x:Name="ContentArea">
                <!-- Mozilla: Gecko's own window, shown exactly while the selected tab is a live Gecko page. -->
                <hosting:GeckoWindowHost x:Name="GeckoHost"
                                         Visibility="{Binding ShowsGeckoPage, Converter={StaticResource BoolToVisibility}}" />

                <!-- Chromium: every Chromium tab's WebView2 lives here; the model keeps all but the
                     selected tab's hidden (IChromiumBrowser.IsShown). Filled by WebView2Engine. -->
                <Grid x:Name="ChromiumLayer" />

                <!-- Mosaic's own views. Each is visible only while no page is. -->
                <views:StartPage Visibility="{Binding ShowsStartPage, Converter={StaticResource BoolToVisibility}}" />
                <views:EngineMessageView Visibility="{Binding ShowsMessage, Converter={StaticResource BoolToVisibility}}" />

                <!-- Short-lived notice near the bottom of the content area. A Popup, because it
                     has to appear above web content. -->
                <Popup x:Name="NoticePopup"
                       PlacementTarget="{Binding ElementName=ContentArea}"
                       Placement="Custom"
                       AllowsTransparency="True"
                       Focusable="False"
                       StaysOpen="True"
                       PopupAnimation="Fade"
                       IsOpen="{Binding HasNotice, Mode=OneWay}">
                    <Border Margin="8"
                            IsHitTestVisible="False"
                            Padding="14,8"
                            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <TextBlock MaxWidth="520"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding Notice}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
