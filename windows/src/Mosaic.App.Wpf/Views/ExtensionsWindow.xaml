<Window x:Class="Mosaic.App.Views.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:Mosaic.Core.Browser;assembly=Mosaic.Core"
        xmlns:extensions="clr-namespace:Mosaic.Core.Extensions;assembly=Mosaic.Core"
        Title="Extensions"
        Width="680" Height="560"
        MinWidth="560" MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Install and manage Chrome extensions. DataContext: ExtensionManager. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Extensions" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,2,0,0"
                           Text="Chrome extensions (.crx) are converted and run on the Mozilla engine." />
            </StackPanel>
            <Button Grid.Column="1"
                    MinWidth="80"
                    VerticalAlignment="Top"
                    Content="Done"
                    IsCancel="True"
                    Click="Done_Click" />
        </Grid>

        <!-- Install from a link, an ID, or a file -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource FieldBorderStyle}" Height="32" CornerRadius="5">
                <Grid>
                    <TextBlock Text="Chrome Web Store link or extension ID">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=InstallInput}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="InstallInput"
                             Style="{StaticResource BareTextBoxStyle}"
                             KeyDown="InstallInput_KeyDown"
                             TextChanged="InstallInput_TextChanged"
                             AutomationProperties.Name="Chrome Web Store link or extension ID" />
                </Grid>
            </Border>
            <Button x:Name="InstallButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    MinWidth="80"
                    Content="Install"
                    IsEnabled="False"
                    Click="Install_Click" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Choose .crx…"
                    IsEnabled="{Binding IsIdle}"
                    Click="ChooseFile_Click" />
            <Control Grid.Column="3"
                     Style="{StaticResource SpinnerStyle}"
                     Width="18" Height="18"
                     Margin="10,0,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- What went wrong last, if anything -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource GlyphStyle}"
                       Margin="0,2,8,0"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="&#xE7BA;" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource BareTextBoxStyle}"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Text="{Binding ErrorMessage, Mode=OneWay}"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="Error" />
        </Grid>

        <Border Grid.Row="3"
                Height="1"
                Margin="0,14,0,12"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- Nothing installed yet -->
        <StackPanel Grid.Row="4"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasExtensions, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource GlyphStyle}" HorizontalAlignment="Center" FontSize="28" Text="&#xEA86;" />
            <TextBlock Margin="0,8,0,4" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No extensions yet" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                       TextAlignment="Center"
                       Text="Paste a Chrome Web Store link above, or open a listing in a tab and press Add to Mosaic." />
        </StackPanel>

        <!-- Installed extensions -->
        <ScrollViewer Grid.Row="4"
                      Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasExtensions, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type browser:ExtensionItem}">
                        <Border Margin="0,0,0,10"
                                Padding="12"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon, or a puzzle piece when the extension has none Mosaic can show -->
                                    <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock HorizontalAlignment="Center" FontSize="22" Text="&#xEA86;">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=IconView}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image x:Name="IconView"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding IconFile, Converter={StaticResource IconImage}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Text="{Binding Version}" />
                                            <Border Style="{StaticResource BadgeStyle}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{Binding ManifestBadge}" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                    ToolTip="Loaded in the Mozilla engine"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           Text="Running" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    ToolTip="Experimental: the unconverted extension is also loaded in Chromium tabs"
                                                    Visibility="{Binding IsInChromium, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="Chromium · experimental" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                   Margin="0,3,0,0"
                                                   MaxHeight="36"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="2"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Top"
                                              Content="Enabled"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Click="Enabled_Click"
                                              AutomationProperties.Name="{Binding EnableLabel}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                Content="Open Popup"
                                                Click="OpenPopup_Click"
                                                Visibility="{Binding HasPopup, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Margin="0,0,8,0"
                                                Content="Options"
                                                Click="OpenOptions_Click"
                                                Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" />
                                        <ToggleButton x:Name="NotesToggle"
                                                      Content="{Binding CompatibilityLabel}"
                                                      ToolTip="Show what was changed or may not work"
                                                      Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove" Click="Remove_Click" />
                                </Grid>

                                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Visibility="{Binding HasChromiumError, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="Not loaded in Chromium (experimental):" />
                                    <Run Text="{Binding ChromiumError, Mode=OneWay}" />
                                </TextBlock>

                                <!-- Compatibility notes, revealed by the toggle above -->
                                <ItemsControl Margin="0,8,0,0"
                                              Focusable="False"
                                              ItemsSource="{Binding Notes}"
                                              Visibility="{Binding IsChecked, ElementName=NotesToggle, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type extensions:CompatibilityNote}">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,2,7,0" VerticalAlignment="Top" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
                                                            <Setter Property="Text" Value="&#xE946;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static extensions:NoteSeverity.Warning}">
                                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static extensions:NoteSeverity.Blocker}">
                                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           FontSize="12"
                                                           Text="{Binding Message}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Shown only when the Chromium engine can take extensions at all -->
        <TextBlock x:Name="ChromiumFootnote"
                   Grid.Row="5"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Text="Experimental: enabled extensions are also offered, unconverted, to Chromium tabs. Rows show where that worked." />
    </Grid>
</Window>
